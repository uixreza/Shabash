// Prisma schema — https://pris.ly/d/prisma-schema
// Datasource URL is configured in prisma7.config.ts via env("DATABASE_URL").

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  phone        String   @unique @db.VarChar(15)
  name         String?
  nationalId   String?  @map("national_id") @db.VarChar(10)
  dateOfBirth  String?  @map("date_of_birth") @db.VarChar(10)
  state        String?  @db.VarChar(50)
  city         String?  @db.VarChar(50)
  role         UserRole @default(user)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  supportTickets SupportTicket[]

  @@map("users")
}

enum UserRole {
  user
  admin
}

enum SupportTicketStatus {
  pending
  answered
  closed
}

enum SupportMessageSender {
  user
  support
}

model SupportTicket {
  id        Int                @id @default(autoincrement())
  userId    Int                @map("user_id")
  title     String             @db.VarChar(120)
  category  String             @db.VarChar(50)
  status    SupportTicketStatus @default(pending)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  SupportTicketMessage[]

  @@index([userId, createdAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id        Int                  @id @default(autoincrement())
  ticketId  Int                  @map("ticket_id")
  sender    SupportMessageSender
  body      String
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  ticket    SupportTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

enum WeddingRequestStatus {
  submitted
  under_review
  consultation_scheduled
  consultation_completed
}

model WeddingRequest {
  id               String                @id
  groomName        String                @map("groom_name")
  brideName        String                @map("bride_name")
  phone            String                @db.VarChar(15)
  weddingDate      String?               @map("wedding_date") @db.VarChar(10)
  venue            String?
  style            String?
  notes            String?
  budgetTotal      Int?                  @map("budget_total")
  budgetAllocation Json                  @map("budget_allocation")
  services         Json
  status           WeddingRequestStatus  @default(submitted)
  submittedAt      DateTime              @default(now()) @map("submitted_at") @db.Timestamptz(6)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([phone])
  @@map("wedding_requests")
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  phone     String   @db.VarChar(15)
  code      String   @db.VarChar(5)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone], map: "idx_verification_codes_phone")
  @@map("verification_codes")
}
