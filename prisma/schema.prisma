// Prisma schema — https://pris.ly/d/prisma-schema
// Datasource URL is configured in prisma7.config.ts via env("DATABASE_URL").

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  phone        String   @unique @db.VarChar(15)
  name         String?
  nationalId   String?  @map("national_id") @db.VarChar(10)
  dateOfBirth  String?  @map("date_of_birth") @db.VarChar(10)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("users")
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  phone     String   @db.VarChar(15)
  code      String   @db.VarChar(5)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone], map: "idx_verification_codes_phone")
  @@map("verification_codes")
}
